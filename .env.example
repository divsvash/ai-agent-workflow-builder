# --- Hasura GraphQL (used for every DB read/write except quota admission) ---
HASURA_GRAPHQL_ENDPOINT=https://<your-project>.hasura.<region>.nhost.run/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=

# --- Direct Postgres connection (used ONLY for atomic quota admission) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Shared secret Hasura sends on every Action / Event Trigger call to
#     these functions, so the functions can reject calls that didn't come
#     through Hasura. Must match the value Hasura is configured to send
#     (see nhost/metadata/actions.yaml and public_workflow_outputs.yaml).
ACTION_SECRET=

# --- Base URL these Nhost Functions are reachable at, referenced from
#     Hasura metadata as {{ACTIONS_BASE_URL}} (e.g. an env var configured
#     on the Hasura instance itself, not just here) ---
# Local dev example: http://localhost:1337/v1/functions
# Deployed example:  https://<subdomain>.functions.<region>.nhost.run/v1
ACTIONS_BASE_URL=

# --- Groq LLM provider ---
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant

# --- notify pipeline (optional; if unset, notify steps are recorded but no
#     Slack delivery is attempted) ---
SLACK_WEBHOOK_URL=
